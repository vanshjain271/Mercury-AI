STORE_CORS=http://localhost:8000,http://localhost:3000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3001,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3001,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Mercury Agent Gateway / AI layer.
# Never commit a real key here - this is a template only. Keep the real
# value in .env (gitignored). Anthropic API budget for this project is
# small, so the bounds below matter - see src/mercury/config.ts.
ANTHROPIC_API_KEY=
MERCURY_AI_MODEL=claude-sonnet-5
MERCURY_AI_MAX_OUTPUT_TOKENS=1024
MERCURY_AI_MAX_TOOL_ITERATIONS=6
MERCURY_AI_REQUEST_TIMEOUT_MS=30000
MERCURY_AI_MAX_RETRIES=1

# Mercury Policy Engine defaults (whole INR rupees). Real ceilings live in
# the `policy` table once seeded/configured from the Merchant OS; these are
# only the fallback used when no row exists yet.
MERCURY_AGENT_MAX_ORDER_INR=5000
MERCURY_AGENT_MAX_PAYMENT_INR=5000

# Razorpay TEST-mode credentials only. Get these from the Razorpay
# dashboard's Test Mode API Keys screen - never use live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Used server-side by Mercury's gateway tools to call the backend's own
# Store API (see src/mercury/gateway/store-client.ts).
MEDUSA_BACKEND_URL=http://localhost:9000
